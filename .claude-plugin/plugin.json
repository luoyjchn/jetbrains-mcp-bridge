{
  "name": "jetbrains-mcp-bridge",
  "displayName": "JetBrains MCP Bridge",
  "version": "0.2.4",
  "description": "Bridge JetBrains IDE features to Claude Code via MCP",
  "author": {
    "name": "luoyjchn"
  },
  "repository": "https://github.com/luoyjchn/jetbrains-mcp-bridge",
  "homepage": "https://github.com/luoyjchn/jetbrains-mcp-bridge",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "plugin",
    "jetbrains",
    "mcp",
    "ide"
  ],
  "defaultEnabled": true,
  "skills": [
    "./skills/setup/"
  ],
  "userConfig": {
    "debug": {
      "type": "boolean",
      "default": "false",
      "description": "Enable hook logging to {CLAUDE_PLUGIN_DATA}/hook.log"
    }
  }
}
